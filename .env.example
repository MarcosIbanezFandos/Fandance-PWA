# --- Backend (Vercel serverless / local FastAPI) ---
# Desde la fusión de 2026-08 los datos viven en el proyecto Supabase de FANDiOS,
# dentro del esquema 'fandance' (DDL en supabase/fandance_schema.sql). El backend
# también acepta NEXT_PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY como
# fallback (las variables que ya define el proyecto Vercel de FANDiOS).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key_here
SUPABASE_DB_SCHEMA=fandance

# Orígenes autorizados para CORS, separados por comas. Sin esto solo se permite
# localhost (los dominios *.vercel.app del propio despliegue se añaden solos).
# Nunca "*": el backend acepta credenciales.
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# --- Frontend (Vite) ---
# En el despliegue fusionado (fandios.vercel.app/fandance) VITE_API_URL es
# /fandance/api; en un despliegue standalone de este repo sería /api.
VITE_API_URL=/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
